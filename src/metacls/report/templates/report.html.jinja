<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ S.title }}</title>
<style>{{ css | safe }}
.msc-src { padding:0 22px 18px; color:var(--muted); font-size:12px; word-break:break-all; }
h3.msc-h { font-size:13px; letter-spacing:.04em; color:var(--muted); text-transform:uppercase;
  margin:26px 0 10px; }
.msc-filter { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0 14px; }
.msc-filter button { background:var(--panel-2); color:var(--muted); border:1px solid var(--border);
  border-radius:999px; padding:4px 12px; font-size:12px; font-weight:700; cursor:pointer; }
.msc-filter button.on { background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
details.msc-card > summary { cursor:pointer; list-style:none; display:flex; align-items:center;
  gap:10px; flex-wrap:wrap; }
details.msc-card > summary::-webkit-details-marker { display:none; }
details.msc-card > summary::before { content:"▸"; color:var(--muted); font-size:11px; }
details.msc-card[open] > summary::before { content:"▾"; }
details.msc-card .msc-file { font-size:12.5px; }
.msc-count { color:var(--muted); font-size:12px; margin-left:auto; }
body.f-cleaned .msc-card:not(.is-cleaned),
body.f-skipped .msc-card:not(.is-skipped),
body.f-error .msc-card:not(.is-error),
body.f-residual .msc-card:not(.has-residual) { display:none; }
@media print {
  .msc-filter, details.msc-card > summary::before { display:none; }
  body { background:#fff; color:#000; }
  .msc-hero, .msc-card { border-color:#bbb; break-inside:avoid; }
  details.msc-card { display:block !important; }
  details.msc-card > * { display:revert !important; }
}
</style>
</head>
<body>
<div class="msc-header">
  <div class="msc-mark">meta<b>cls</b></div>
  <div class="msc-tag">{{ S.tagline }}</div>
</div>
<div class="msc-main">

  <div class="msc-hero">
    <div class="msc-hero-band">
      {% if report.dry_run %}
        <span class="msc-hero-state">{{ S.hero_dry }}</span>
      {% elif state == 'bad' %}
        <span class="msc-hero-state bad">{{ S.hero_bad }}</span>
        <span class="msc-hero-sub">{{ S.hero_sub_bad }}</span>
      {% elif state == 'warn' %}
        <span class="msc-hero-state warn">{{ S.hero_warn }}</span>
        <span class="msc-hero-sub">{{ S.hero_sub_warn }}</span>
      {% else %}
        <span class="msc-hero-state ok">{{ S.hero_ok }}</span>
        <span class="msc-hero-sub">{{ S.hero_sub_ok }}</span>
      {% endif %}
    </div>
    <div class="msc-stats">
      <div class="msc-stat"><div class="n">{{ results | length }}</div><div class="l">{{ S.sum_files }}</div></div>
      <div class="msc-stat"><div class="n">{{ report.fields_removed }}</div><div class="l">{{ S.sum_removed }}</div></div>
      <div class="msc-stat {% if report.files_with_residual %}warn{% endif %}">
        <div class="n">{{ report.files_with_residual | length }}</div><div class="l">{{ S.sum_residual }}</div></div>
      <div class="msc-stat {% if report.errored %}bad{% endif %}">
        <div class="n">{{ report.errored | length }}</div><div class="l">{{ S.sum_errors }}</div></div>
    </div>
    <div class="msc-src">
      {{ S.generated }}: {{ generated_at }} &nbsp;·&nbsp; {{ S.root }}: {{ report.root }} &nbsp;·&nbsp;
      {{ S.mode }}:
      {% if report.dry_run %}{{ S.mode_dryrun }}{% elif report.in_place %}{{ S.mode_inplace }}{% else %}{{ S.mode_copy }}{% endif %}
      {% if report.tool_versions %} &nbsp;·&nbsp; {{ report.tool_versions.items() | map('join', ' ') | join('  ') }}{% endif %}
    </div>
  </div>

  <h3 class="msc-h">{{ S.res_title }}</h3>
  <div class="msc-filter" id="msc-filter">
    <button data-f="" class="on">{{ S.filter_all }} ({{ results | length }})</button>
    <button data-f="cleaned">{{ S.status_cleaned }} ({{ report.counts.get('cleaned', 0) }})</button>
    {% if report.counts.get('skipped') %}<button data-f="skipped">{{ S.status_skipped }} ({{ report.counts.get('skipped') }})</button>{% endif %}
    {% if report.errored %}<button data-f="error">{{ S.status_error }} ({{ report.errored | length }})</button>{% endif %}
    {% if report.files_with_residual %}<button data-f="residual">{{ S.sum_residual }} ({{ report.files_with_residual | length }})</button>{% endif %}
    <button id="msc-expand" style="margin-left:auto">{{ S.expand_all }}</button>
  </div>

  {% for r in results %}
  <details class="msc-card is-{{ r.status }}{% if r.residual %} has-residual{% endif %}"
    {% if r.status in ('error',) or r.residual %}open{% endif %}>
    <summary>
      <span class="msc-pill {{ r.status }}">{{ S['status_' ~ r.status] }}</span>
      <span class="msc-file">{{ r.src_path }}</span>
      <span class="msc-count">{{ r.removed | length }} {{ S.sum_removed }}{% if r.residual %} · ⚠ {{ r.residual | length }}{% endif %}</span>
    </summary>
    <div style="margin:8px 0 0">
      <span class="msc-meta">{{ r.engine }} · .{{ r.filetype }}
        {% if r.bytes_before %}· {{ S.size }} {{ r.bytes_before }} → {{ r.bytes_after }} B{% endif %}
      </span>
    </div>
    {% if r.reason %}<div class="msc-meta">{{ r.reason }}</div>{% endif %}
    {% if r.error %}<div class="msc-residual">{{ r.error }}</div>{% endif %}
    {% if r.out_path and not report.in_place %}<div class="msc-meta">{{ S.out }}: {{ r.out_path }}</div>{% endif %}

    {% if r.removed %}
    <table class="msc-diff">
      <thead><tr>
        <th>{{ S.col_namespace }}</th><th>{{ S.col_field }}</th>
        <th>{% if report.dry_run %}{{ S.would_remove }}{% else %}{{ S.col_before }}{% endif %}</th>
      </tr></thead>
      <tbody>
      {% for c in r.removed %}
        <tr><td>{{ c.namespace }}</td><td>{{ c.field }}</td><td class="was">{{ c.before }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% elif r.status == 'cleaned' %}
    <div class="msc-empty">{{ S.no_meta }}</div>
    {% endif %}

    {% if r.kept %}<div class="msc-kept">✓ {{ S.kept }}: {{ r.kept | join(', ') }}</div>{% endif %}
    {% if r.residual %}<div class="msc-residual">⚠ {{ S.residual }}: {{ r.residual | join(', ') }}</div>{% endif %}
  </details>
  {% endfor %}
</div>
<script>
(function () {
  var bar = document.getElementById('msc-filter');
  bar.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-f]');
    if (!b) return;
    document.body.className = b.dataset.f ? 'f-' + b.dataset.f : '';
    bar.querySelectorAll('button[data-f]').forEach(function (x) { x.classList.toggle('on', x === b); });
  });
  var exp = document.getElementById('msc-expand'), open = false;
  exp.addEventListener('click', function () {
    open = !open;
    document.querySelectorAll('details.msc-card').forEach(function (d) { d.open = open; });
    exp.textContent = open ? '{{ S.collapse_all }}' : '{{ S.expand_all }}';
  });
})();
</script>
</body>
</html>
