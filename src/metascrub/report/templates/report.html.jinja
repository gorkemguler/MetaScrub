<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ S.title }}</title>
<style>{{ css | safe }}
.msc-src { padding:0 22px 18px; color:var(--muted); font-size:12px; word-break:break-all; }
h3.msc-h { font-size:13px; letter-spacing:.04em; color:var(--muted); text-transform:uppercase;
  margin:26px 0 10px; }
</style>
</head>
<body>
<div class="msc-header">
  <div class="msc-mark">meta<b>scrub</b></div>
  <div class="msc-tag">{{ S.tagline }}</div>
</div>
<div class="msc-main">

  <div class="msc-hero">
    <div class="msc-hero-band">
      {% if report.dry_run %}
        <span class="msc-hero-state">{{ S.hero_dry }}</span>
      {% elif state == 'bad' %}
        <span class="msc-hero-state bad">{{ S.hero_bad }}</span>
        <span class="msc-hero-sub">{{ S.hero_sub_bad }}</span>
      {% elif state == 'warn' %}
        <span class="msc-hero-state warn">{{ S.hero_warn }}</span>
        <span class="msc-hero-sub">{{ S.hero_sub_warn }}</span>
      {% else %}
        <span class="msc-hero-state ok">{{ S.hero_ok }}</span>
        <span class="msc-hero-sub">{{ S.hero_sub_ok }}</span>
      {% endif %}
    </div>
    <div class="msc-stats">
      <div class="msc-stat"><div class="n">{{ results | length }}</div><div class="l">{{ S.sum_files }}</div></div>
      <div class="msc-stat"><div class="n">{{ report.fields_removed }}</div><div class="l">{{ S.sum_removed }}</div></div>
      <div class="msc-stat {% if report.files_with_residual %}warn{% endif %}">
        <div class="n">{{ report.files_with_residual | length }}</div><div class="l">{{ S.sum_residual }}</div></div>
      <div class="msc-stat {% if report.errored %}bad{% endif %}">
        <div class="n">{{ report.errored | length }}</div><div class="l">{{ S.sum_errors }}</div></div>
    </div>
    <div class="msc-src">
      {{ S.generated }}: {{ generated_at }} &nbsp;·&nbsp; {{ S.root }}: {{ report.root }} &nbsp;·&nbsp;
      {{ S.mode }}:
      {% if report.dry_run %}{{ S.mode_dryrun }}{% elif report.in_place %}{{ S.mode_inplace }}{% else %}{{ S.mode_copy }}{% endif %}
      {% if report.tool_versions %} &nbsp;·&nbsp; {{ report.tool_versions.items() | map('join', ' ') | join('  ') }}{% endif %}
    </div>
  </div>

  <h3 class="msc-h">{{ S.res_title }}</h3>

  {% for r in results %}
  <div class="msc-card is-{{ r.status }}">
    <div class="msc-file">{{ r.src_path }}</div>
    <div style="margin:7px 0">
      <span class="msc-pill {{ r.status }}">{{ S['status_' ~ r.status] }}</span>
      <span class="msc-meta">&nbsp; {{ r.engine }} · .{{ r.filetype }}
        {% if r.bytes_before %}· {{ S.size }} {{ r.bytes_before }} → {{ r.bytes_after }} B{% endif %}
      </span>
    </div>
    {% if r.reason %}<div class="msc-meta">{{ r.reason }}</div>{% endif %}
    {% if r.error %}<div class="msc-residual">{{ r.error }}</div>{% endif %}
    {% if r.out_path and not report.in_place %}<div class="msc-meta">{{ S.out }}: {{ r.out_path }}</div>{% endif %}

    {% if r.removed %}
    <table class="msc-diff">
      <thead><tr>
        <th>{{ S.col_namespace }}</th><th>{{ S.col_field }}</th>
        <th>{% if report.dry_run %}{{ S.would_remove }}{% else %}{{ S.col_before }}{% endif %}</th>
      </tr></thead>
      <tbody>
      {% for c in r.removed %}
        <tr><td>{{ c.namespace }}</td><td>{{ c.field }}</td><td class="was">{{ c.before }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% elif r.status == 'cleaned' %}
    <div class="msc-empty">{{ S.no_meta }}</div>
    {% endif %}

    {% if r.kept %}<div class="msc-kept">✓ {{ S.kept }}: {{ r.kept | join(', ') }}</div>{% endif %}
    {% if r.residual %}<div class="msc-residual">⚠ {{ S.residual }}: {{ r.residual | join(', ') }}</div>{% endif %}
  </div>
  {% endfor %}
</div>
</body>
</html>
