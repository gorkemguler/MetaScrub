# MetaScrub has almost no configuration — these just set defaults so you
# don't have to pass the same flags every time. Copy to .env and edit.

# Where cleaned copies and run reports are written (CLI --out, web/api --output-dir).
# METASCRUB_OUTPUT_DIR=./metascrub_cleaned

# Default report language for the HTML report: en | tr
# METASCRUB_REPORT_LANG=en
