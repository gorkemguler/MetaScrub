# systemd template unit for `metascrub watch`.
#
#   sudo cp metascrub-watch@.service /etc/systemd/system/
#   sudo systemctl enable --now 'metascrub-watch@srv-ftp-incoming'
#
# The instance name after @ is a systemd-escaped path; the example above
# watches /srv/ftp/incoming. Adjust User=, the venv path, and the flags.

[Unit]
Description=MetaScrub — keep %I scrubbed
After=network.target

[Service]
Type=simple
User=metascrub
Group=metascrub
# Point this at wherever metascrub is installed (a venv, pipx, or system).
ExecStart=/opt/metascrub/.venv/bin/metascrub watch /%I \
    --move-processed /%I/../scrubbed \
    --interval 10 --settle 5
Restart=on-failure
RestartSec=5
# Hardening — the watcher only needs to read/write the drop dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/%I /%I/../scrubbed

[Install]
WantedBy=multi-user.target
